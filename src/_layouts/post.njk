---
layout: base.njk
---

<article class="post-page">
    <section class="page-hero relative flex min-h-124 items-center justify-center overflow-hidden bg-primary-container">
        {% if image %}
            {% set imageGravityPosition = imageGravity | imageGravityPosition %}
            <div class="absolute inset-0 z-0">
                <div class="page-hero-overlay absolute inset-0 z-10"></div>
                <img class="post-hero-image h-full w-full object-cover" style="--post-hero-image-position: {{ imageGravityPosition }};" alt="" src="{{ image }}">
            </div>
        {% else %}
            <div class="absolute inset-0 z-0 bg-linear-to-br from-primary-container via-primary to-info"></div>
        {% endif %}

        <div class="page-hero-inner relative z-20 mx-auto max-w-5xl px-6 text-center">
            <p class="eyebrow text-white/90!">Forum Update</p>
            <h1 class="mx-auto mt-4 max-w-4xl font-headline text-[3.1rem] font-extrabold leading-[0.98] tracking-[-0.045em] text-on-primary-container md:text-[4.8rem]">
                {{ title }}
            </h1>
            <div class="mt-7 flex flex-wrap items-center justify-center gap-3 text-on-primary-container/88">
                <time class="font-mono text-sm font-semibold" datetime="{{ page.date | htmlDateString }}">
                    {{ page.date | readableDate("LLLL d, yyyy") }}
                </time>
                {% if draft %}
                    <span class="inline-flex items-center rounded-full border border-white/20 bg-white/12 px-3 py-1 font-label text-xs font-bold uppercase tracking-[0.14em] text-white backdrop-blur-sm">
                        Draft
                    </span>
                {% endif %}
            </div>
        </div>
    </section>

    <section class="border-y border-outline-variant/30 bg-surface-container-low/70">
        <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-8 py-6">
            <a class="chip-link" href="/posts/">
                <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_back</span>
                All posts
            </a>
            {% if tags %}
                <div class="flex flex-wrap items-center justify-end gap-2">
                    {% for tag in tags %}
                        {% if tag != "post" %}
                            <span class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-4 py-2 font-label text-sm font-bold uppercase tracking-[0.14em] text-primary">
                                <span class="material-symbols-outlined text-base" aria-hidden="true">campaign</span>
                                {{ tag | replace("-", " ") }}
                            </span>
                        {% endif %}
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </section>

    <section class="px-8 py-20 lg:py-24">
        <div class="mx-auto grid max-w-5xl gap-10 lg:grid-cols-[14rem_minmax(0,1fr)] lg:items-start">
            <aside class="surface-card p-6 lg:sticky lg:top-36">
                <p class="eyebrow">Published</p>
                <time class="mt-3 block font-headline text-2xl font-extrabold leading-tight tracking-[-0.03em] text-on-surface" datetime="{{ page.date | htmlDateString }}">
                    {{ page.date | readableDate("LLL d, yyyy") }}
                </time>
                <a class="mt-8 inline-flex items-center gap-2 font-label text-sm font-bold uppercase tracking-[0.14em] text-primary hover:text-on-primary-fixed-variant" href="/posts/">
                    <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_back</span> Posts
                    
                </a>
            </aside>

            <div class="surface-card p-8 md:p-10 lg:p-12">
                <div class="post-content">
                    {{ content | safe }}
                </div>
            </div>
        </div>
    </section>
</article>
