---
layout: base.njk
---
{# Hero section #}
<section class="page-hero relative flex min-h-116 items-center justify-center overflow-hidden bg-primary-container">
    {% set imageGravityPosition = imageGravity | imageGravityPosition %}
    <div id="hero" class="absolute inset-0 z-0">
        <div class="page-hero-overlay absolute inset-0 z-10"></div>
        <img class="post-hero-image h-full w-full object-cover" style="--post-hero-image-position: {{ imageGravityPosition }};" alt="" src="{{ cover }}"/>
    </div>
    <div class="page-hero-inner relative z-20 mx-auto max-w-4xl px-6 text-center">
        <h1 class="font-headline text-[3.4rem] leading-[0.98] tracking-[-0.045em] text-on-primary-container md:text-[5.2rem]">{{ title }}</h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-on-primary-container/84 md:text-[1.35rem]">{{ byline }}</p>
        {% if heroButtons %}
            <div class="page-hero-actions mt-10 flex flex-col justify-center gap-4 sm:flex-row">
                {% for button in heroButtons %}
                    {% set buttonUrl = button.url %}
                    {% if button.metadataKey and metadata[button.metadataKey] %}
                        {% set buttonUrl = metadata[button.metadataKey] %}
                    {% endif %}

                    {% if buttonUrl %}
                        <a class="{{ button.class | default('button-primary') }}" href="{{ buttonUrl }}"{% if button.external %} target="_blank" rel="{{ button.rel | default('noopener noreferrer') }}"{% endif %}>{{ button.text }}</a>
                    {% elif button.fallbackText %}
                        <span class="{{ button.fallbackClass | default('inline-flex items-center justify-center rounded-full bg-tertiary-container px-8 py-4 font-label text-lg font-semibold text-on-tertiary-container shadow-card') }}">{{ button.fallbackText }}</span>
                    {% endif %}
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>

{{ content | safe }}
